@startuml
left to right direction
skinparam shadowing false
actor "Người chơi\n(Người 1 / Người 2)" as Player
rectangle "Boom Boom Kiss" {
  usecase "UC01\nTùy chỉnh theme" as Theme
  usecase "UC02\nBắt đầu ván" as Start
  usecase "UC03\nĐặt bánh và xác nhận" as Setup
  usecase "Kiểm tra số bánh" as Validate
  usecase "Che bàn khi chuyển máy" as Cover
  usecase "UC04\nĐặt ngẫu nhiên" as Random
  usecase "UC05\nMở ô đối thủ" as Attack
  usecase "Xử lý ô và luật nổ" as Resolve
  usecase "UC06\nXem kết quả" as Result
  usecase "UC07\nChơi lại" as Again
  usecase "UC08\nVề trang chủ" as Home
}
Player -- Theme
Player -- Start
Player -- Setup
Player -- Random
Player -- Attack
Player -- Result
Player -- Again
Player -- Home
Setup ..> Validate : <<include>>
Setup ..> Cover : <<include>>
Random ..> Setup : <<extend>>\nChọn Ngẫu nhiên
Attack ..> Resolve : <<include>>
Result ..> Attack : <<extend>>\nKiss bị mở
@enduml
